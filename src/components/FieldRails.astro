---
// Sidelines run down the two page edges. The field between the end zones is
// always 100 yards however long the page gets, so every mark is placed as a
// percentage — never in pixels. Numerals are HTML, not a stretched SVG, so
// they never distort as the field grows.
const marks = [];
for (let y = 0; y <= 100; y++) {
  const isTen = y % 10 === 0 && y !== 0 && y !== 100;
  marks.push({
    y,
    kind: y === 0 || y === 100 ? 'goal' : isTen ? 'ten' : y % 5 === 0 ? 'five' : 'one',
    // counts up to the 50 from each goal line and back down
    num: isTen ? String(y <= 50 ? y : 100 - y) : null,
    // arrow points at the nearer end zone; the 50 never has one
    arrow: isTen && y !== 50 ? (y < 50 ? 'up' : 'down') : null,
  });
}
---
<div class="rails" aria-hidden="true">
  {['l', 'r'].map(side => (
    <div class={`rail rail-${side}`}>
      <span class="sideline"></span>
      {marks.map(m => <span class={`mk mk-${m.kind}`} style={`top:${m.y}%`}></span>)}
      {marks.filter(m => m.num).map(m => (
        <span class="ynum" style={`top:${m.y}%`}>
          <b class="d1">{m.num[0]}</b>
          <b class="d2">{m.num[1]}</b>
          {m.arrow && <i class={`arw ${m.arrow}`}></i>}
        </span>
      ))}
    </div>
  ))}
</div>
