---
import skin from '../skin.js';

// The field is its own layer. It sticks to the viewport and travels slower
// than the page, so the content reads as flying over it.
//
// The first five yards are cut: the field opens on the five, so the ten
// arrives one short run after the hero rather than two. Everything inside
// .pitch is positioned as a percentage of that 95-yard band — never in
// pixels — so the run holds at any page height.
const FROM = 5, SPAN = 100 - FROM;
const pct = (y) => ((y - FROM) / SPAN) * 100;
const marks = [];
for (let y = FROM; y <= 100; y++) {
  const isTen = y % 10 === 0 && y !== 100;
  marks.push({
    y: pct(y),
    kind: y === 100 ? 'goal' : isTen ? 'ten' : y % 5 === 0 ? 'five' : 'one',
    num: isTen ? String(y <= 50 ? y : 100 - y) : null,
    arrow: isTen && y !== 50 ? (y < 50 ? 'up' : 'down') : null,
  });
}
// the midfield logo is painted across the 50, ten yards either side of it
const LOGO_TOP = pct(40), LOGO_H = pct(60) - pct(40);
// the end zone: the last ten yards, painted on the field itself
const EZ_TOP = pct(90);
---
<div class="turf-stage" aria-hidden="true">
  <div class="turf-scroll" id="turfScroll">
    <div class="pitch" id="pitch">
      <div class="turf"></div>

      {/* the end zone — the last ten yards of turf, hatched, so the
          TOUCHDOWN band is field rather than a slab laid on top of it */}
      <div class="ez-paint" style={`top:${EZ_TOP}%`}></div>

      {/* painted at midfield, spanning the 40 to the 40 — the hero lockup,
          same three lines, same fonts, sized in yards instead of pixels */}
      <div class="midfield" style={`top:${LOGO_TOP}%;height:${LOGO_H}%`}>
        <span class="mf-mark" set:html={skin.brand.wordmarkTop}></span>
        <span class="mf-line" set:html={skin.brand.wordmarkBottom}></span>
        <span class="mf-sub">{skin.hero.subtag}</span>
      </div>

      {['l', 'r'].map(side => (
        <div class={`rail rail-${side}`}>
          <span class="sideline"></span>
          {marks.map(m => <span class={`mk mk-${m.kind}`} style={`top:${m.y}%`}></span>)}
          {marks.filter(m => m.num).map(m => (
            <span class="ynum" style={`top:${m.y}%`}>
              <b class="d1">{m.num[0]}</b>
              <b class="d2">{m.num[1]}</b>
              {m.arrow && <i class={`arw ${m.arrow}`}></i>}
            </span>
          ))}
        </div>
      ))}
      {/* hash marks — two inboard rows, one yard apart, as on a real field */}
      {['hl', 'hr'].map(h => (
        <div class={`hash ${h}`}>
          {marks.filter(m => m.kind !== 'goal').map(m => (
            <span class="hm" style={`top:${m.y}%`}></span>
          ))}
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  // Parallax. The layer's offset is a plain function of how far the page has
  // scrolled, counted from the very top — so it is already drifting on the
  // first notch of the wheel, while the hero is still on screen, rather than
  // snapping into motion once the field reaches the viewport.
  //
  // Because of that head start, the 95-yard band cannot begin at the top of
  // the moving layer: by the time the field's top edge first appears, the
  // layer has already travelled `lead` pixels. The band is offset by exactly
  // that much, so the five-yard line meets the field's top edge on cue, and
  // the goal line lands as the Endzone CTA arrives.
  const stage = document.querySelector('.turf-stage');
  const scroll = document.getElementById('turfScroll');
  const pitch = document.getElementById('pitch');
  const field = document.querySelector('.field');
  if (stage && scroll && pitch && field && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // 1 = locked to the page, 0 = static. Slower on small screens so the
    // sliver of field reads as ground a long way below.
    const rateFor = () => (window.innerWidth <= 900 ? 0.10 : 0.18);
    let RATE = rateFor(), stopAt = 1, ticking = false;

    const measure = () => {
      const vh = window.innerHeight;
      RATE = rateFor();
      const fieldTop = field.getBoundingClientRect().top + window.scrollY;
      const fieldH = field.offsetHeight;

      // the layer stops moving once the field's bottom reaches the viewport
      // bottom, so the footer never has field sliding behind it
      stopAt = Math.max(1, fieldTop + fieldH - vh);

      const lead = Math.max(0, fieldTop - vh) * RATE;   // travelled before the field shows
      const band = fieldH * RATE + vh;                  // what the 95 yards must cover

      scroll.style.height = `${lead + band}px`;
      pitch.style.top = `${lead}px`;
      pitch.style.height = `${band}px`;
      // one yard. The field runs the five to the goal line — 95 yards — so
      // the stripes, the paint and the midfield logo stay locked to the numerals.
      pitch.style.setProperty('--yd', `${band / 95}px`);
      place();
    };
    const place = () => {
      const y = Math.min(window.scrollY, stopAt) * RATE;
      scroll.style.transform = `translate3d(0,${-y.toFixed(1)}px,0)`;
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(place); } };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    // the folds change the field height when they open
    document.querySelectorAll('details.fold').forEach(d => d.addEventListener('toggle', measure));
    measure();
  }

  // The hero photo drifts slower than the page. It bleeds 22% past the
  // section on both sides, so it can travel that far without showing an edge.
  const hero = document.querySelector('.hero-section.has-photo');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let hticking = false;
    const hplace = () => {
      const hh = Math.max(1, hero.offsetHeight);
      const p = Math.min(1, Math.max(0, window.scrollY / hh));
      hero.style.setProperty('--hero-y', `${(p * hh * 0.22).toFixed(1)}px`);
      hticking = false;
    };
    addEventListener('scroll', () => { if (!hticking) { hticking = true; requestAnimationFrame(hplace); } }, { passive: true });
    addEventListener('resize', hplace);
    hplace();
  }
</script>
