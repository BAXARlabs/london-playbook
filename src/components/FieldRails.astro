---
// The field is its own layer. It sticks to the viewport and travels slower
// than the page, so the content reads as flying over it. The markings are
// always exactly 100 yards from the hero end zone to the Endzone CTA,
// positioned by percentage of the field layer — never in pixels.
const marks = [];
for (let y = 0; y <= 100; y++) {
  const isTen = y % 10 === 0 && y !== 0 && y !== 100;
  marks.push({
    y,
    kind: y === 0 || y === 100 ? 'goal' : isTen ? 'ten' : y % 5 === 0 ? 'five' : 'one',
    num: isTen ? String(y <= 50 ? y : 100 - y) : null,
    arrow: isTen && y !== 50 ? (y < 50 ? 'up' : 'down') : null,
  });
}
---
<div class="turf-stage" aria-hidden="true">
  <div class="turf-scroll" id="turfScroll">
    <div class="turf"></div>
    {['l', 'r'].map(side => (
      <div class={`rail rail-${side}`}>
        <span class="sideline"></span>
        {marks.map(m => <span class={`mk mk-${m.kind}`} style={`top:${m.y}%`}></span>)}
        {marks.filter(m => m.num).map(m => (
          <span class="ynum" style={`top:${m.y}%`}>
            <b class="d1">{m.num[0]}</b>
            <b class="d2">{m.num[1]}</b>
            {m.arrow && <i class={`arw ${m.arrow}`}></i>}
          </span>
        ))}
      </div>
    ))}
    {/* hash marks — two inboard rows, one yard apart, as on a real field */}
    {['hl', 'hr'].map(h => (
      <div class={`hash ${h}`}>
        {marks.filter(m => m.kind !== 'goal').map(m => (
          <span class="hm" style={`top:${m.y}%`}></span>
        ))}
      </div>
    ))}
  </div>
</div>

<script>
  // Parallax: the field travels a fraction of the page's distance, so the
  // content flies over it. Everything is recomputed on resize because the
  // field's height changes with the content.
  const stage = document.querySelector('.turf-stage');
  const scroll = document.getElementById('turfScroll');
  const field = document.querySelector('.field');
  if (stage && scroll && field && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // 1 = locked to the page, 0 = static. Slower on small screens so the
    // sliver of field reads as ground a long way below.
    const rateFor = () => (window.innerWidth <= 900 ? 0.10 : 0.18);
    let RATE = rateFor();
    let fieldTop = 0, range = 1, travel = 0, ticking = false;

    const measure = () => {
      const vh = window.innerHeight;
      RATE = rateFor();
      const r = field.getBoundingClientRect();
      fieldTop = r.top + window.scrollY;
      range = Math.max(1, field.offsetHeight - vh);
      travel = range * RATE;
      scroll.style.height = `${vh + travel}px`;
      // one yard, so the mowing stripes stay locked to five-yard bands
      scroll.style.setProperty('--yd', `${(vh + travel) / 100}px`);
      place();
    };
    const place = () => {
      const p = Math.min(1, Math.max(0, (window.scrollY - fieldTop) / range));
      scroll.style.transform = `translate3d(0,${-(p * travel).toFixed(1)}px,0)`;
      ticking = false;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(place); } };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', measure);
    // the folds change the field height when they open
    document.querySelectorAll('details.fold').forEach(d => d.addEventListener('toggle', measure));
    measure();
  }
</script>
