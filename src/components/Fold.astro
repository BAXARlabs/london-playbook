---
// Collapsible reference section. Native <details> so it is keyboard-operable,
// findable by in-page search when open, and works with JS disabled.
const { no, title, meta, sit, id, open = false } = Astro.props;
---
<details class="fold" id={id} open={open}>
  <summary class="fold-head">
    <span class="fold-no">{no}</span>
    {sit && <span class="fold-sit">{sit}</span>}
    <span class="fold-title">{title}</span>
    <span class="fold-meta">{meta}</span>
    <span class="fold-chev" aria-hidden="true"></span>
  </summary>
  <div class="fold-body"><slot /></div>
</details>
