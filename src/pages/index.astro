---
import Base from '../layouts/Base.astro';
import HeroBg from '../components/HeroBg.astro';
import Fold from '../components/Fold.astro';
import FieldRails from '../components/FieldRails.astro';
import skin from '../skin.js';
import toursData from '../data/tours.json';
import venuesData from '../data/venues.json';
import transport from '../data/transport.json';
import tipsData from '../data/tips.json';
import glossary from '../data/glossary.json';
import packages from '../data/packages.json';
import local from '../data/local-knowledge.json';

const base = (skin.site.basePath || '').replace(/\/$/, '');
const ex = new Set(skin.tours?.exclude || []);
const tours = toursData.filter(t => !ex.has(t.n)).map(t => ({ ...t, ...(skin.tours?.overrides?.[t.n] || {}) }));
const cats = [...new Map(tours.map(t => [t.cat, t.catLabel])).entries()];
const venues = (skin.event.venues || []).map(k => venuesData[k]).filter(Boolean);
const exTips = new Set(skin.tips?.exclude || []);
const tips = tipsData.filter(t => !exTips.has(t.id));
const stationCount = venues.reduce((a, v) => a + v.stations.length, 0);
const heroImg = skin.media?.hero ? `${base}/${skin.media.hero}` : null;
const bandImg = skin.media?.band ? `${base}/${skin.media.band}` : null;
const enquiry = skin.enquiryUrl || 'mailto:hello@aileronvip.com?subject=London%20Playbook%20enquiry';

let n = 0; const no = () => String(++n).padStart(2, '0');
const N_GAMEDAY = no(), N_THERE = no(), N_LINEUP = no(), N_PACKS = no(), N_AROUND = no(), N_LOCAL = no(), N_TIPS = no(), N_WORDS = no();
---
<Base>
<section class={`red-canvas hero-section${heroImg ? ' has-photo' : ''}`} style={heroImg ? `--hero-img:url(${heroImg})` : undefined}>
  <HeroBg />
  <div class="hero wrap">
   <div class="hero-plate">
    <div class="eyebrow small-caps">{skin.hero.eyebrow}</div>
    <h1 class="wordmark" set:html={skin.brand.wordmarkTop}></h1>
    <span class="ofline" set:html={skin.brand.wordmarkBottom}></span>
    <div class="subtag">{skin.hero.subtag}</div>
    <p class="tagline" set:html={skin.hero.tagline}></p>
    <div class="ctas">
      <a class="btn on-red" href="#lineup">{skin.hero.ctaPrimary}</a>
      <a class="btn on-red-outline" href="#gameday">{skin.hero.ctaSecondary}</a>
    </div>
   </div>
  </div>
</section>

<div class="field">
<FieldRails />

<section class="scoreboard-section" id="scoreboard">
  <div class="wrap">
    <div class="scoreboard">
      {skin.scoreboard.map(s => (
        <div class="stat">
          <div class="n" data-count={s.star ? undefined : s.n} data-pad={s.pad || 0} data-comma={s.comma ? 1 : undefined}>{s.star ? '★' : (s.pad ? '00' : '0')}</div>
          <div class="l">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="red-canvas gameday-section" id="gameday">
  <div class="gameday wrap">
    <div class="section-no">{N_GAMEDAY} · Game Day</div>
    <div class="label">{skin.event.label}</div>
    <h2 set:html={skin.event.matchup}></h2>
    <div class="where">{skin.event.where}</div>
    <div class="countdown" id="cd" data-kickoff={skin.event.kickoff}>
      <div class="cd-cell"><div class="num" data-cd="d">000</div><div class="lbl">Days</div></div>
      <div class="cd-cell"><div class="num" data-cd="h">00</div><div class="lbl">Hours</div></div>
      <div class="cd-cell"><div class="num" data-cd="m">00</div><div class="lbl">Minutes</div></div>
      <div class="cd-cell"><div class="num" data-cd="s">00</div><div class="lbl">Seconds</div></div>
    </div>
  </div>
</section>

<div class="folds wrap"><div class="sheet">
  <Fold no={N_THERE} sit="1st & 10" title="Getting There" id="getting-there"
        meta={`${venues.length} ${venues.length === 1 ? 'stadium' : 'stadiums'} · ${stationCount} routes`}>
    {venues.map(v => (
      <div class="venue">
        <div class="venue-head">
          <h3>{v.name}</h3>
          <span class="venue-area">{v.area}</span>
        </div>
        <p class="venue-note">{v.note}</p>
        <div class="stations">
          {v.stations.map(st => (
            <div class="station">
              <div class="st-top"><span class="st-name">{st.station}</span><span class="st-walk">{st.walk}</span></div>
              <div class="st-line">{st.line} · {st.from}</div>
              <p class="st-note">{st.note}</p>
            </div>
          ))}
        </div>
        <div class="venue-foot">
          <div><span class="vf-label">Getting out</span><p>{v.leaving}</p></div>
          <div><span class="vf-label">Driving</span><p>{v.driving}</p></div>
        </div>
      </div>
    ))}
  </Fold>
</div></div>

<section class="lineup" id="lineup">
  <div class="wrap">
    <div class="section-no">{N_LINEUP} · The Starting Lineup</div>
    <h2 class="display">Your {tours.length} Tours of London</h2>
    <div class="section-sub">Pick a play. Run the city.</div>
    <div class="filters">
      <button class="filter active" data-cat="all">All Tours</button>
      {cats.map(([c, l]) => <button class="filter" data-cat={c}>{l}</button>)}
    </div>
    <div class="tour-grid" id="tourGrid">
      {tours.map(t => (
        <a class="tour" data-cat={t.cat} href={`${base}/tours/${t.slug}/`}>
          <div class="img">
            <img src={t.img} alt={t.title} width="900" height="563" loading="lazy" />
            <div class="num-medallion">{t.n}</div>
            <div class="cat-pill">{t.catLabel}</div>
          </div>
          <div class="body">
            <h3>{t.title}</h3>
            <p class="desc">{t.short}</p>
            <div class="meta"><span class="dur">⏱ {t.dur}</span><span class="transport">{t.transport}</span></div>
            {t.price && <div class="tour-price">From <strong>£{t.price}</strong></div>}
          </div>
          <div class="footer-bar"><span>View Tour</span><span>↗</span></div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="packages" id="packages">
  <div class="wrap">
    <div class="section-no">{N_PACKS} · Bundles</div>
    <h2 class="display">One Ticket, Several Things</h2>
    <div class="section-sub">{packages.intro}</div>

    {packages.groups.map(g => (
      <div class="pack">
        <div class="pack-head">
          <h3>{g.name}</h3>
          <p>{g.kicker}</p>
        </div>
        <div class="pack-core">
          <span class="pc-label">{g.coreLabel}</span>
          <ul>{g.core.map(c => <li>{c}</li>)}</ul>
        </div>
        <div class="pack-opts">
          {(g.options || g.tiers).map(o => (
            <a class="opt" href={enquiry}>
              <span class="opt-name">{o.name}</span>
              {o.adds && o.adds.length > 0 && <span class="opt-adds">{o.adds.join(' · ')}</span>}
              <span class="opt-price">£{o.price}</span>
              <span class="opt-cta">Enquire ↗</span>
            </a>
          ))}
        </div>
        {g.note && <p class="pack-note">{g.note}</p>}
      </div>
    ))}
    <p class="pack-small">Prices are as quoted by the operator and can change. We will confirm the exact total, and what it covers, before anything is booked.</p>
  </div>
</section>

{bandImg && (
<section class="scrapbook" style={`--band-img:url(${bandImg})`} aria-hidden="true">
  <div class="wrap">
    <span class="sb-label">The rest of the playbook</span>
    <p class="sb-copy">Everything you need before you land — and everything you'll wish someone had told you.</p>
  </div>
</section>
)}

<div class="folds wrap"><div class="sheet">
  <Fold no={N_AROUND} sit="Open Field" title="Getting Around London" id="getting-around" meta={`${transport.cards.length} things to know`}>
    <p class="fold-intro">{transport.intro}</p>
    <div class="around-grid">
      {transport.cards.map(c => (
        <div class="around-card">
          <div class="icon">{c.icon}</div>
          <h4>{c.title}</h4>
          <p set:html={c.body}></p>
          <div class="around-detail">{c.detail}</div>
        </div>
      ))}
    </div>
  </Fold>

  <Fold no={N_LOCAL} sit="Trick Play" title="Local Knowledge" id="local" meta={`${local.items.length} places`}>
    <p class="fold-intro">{local.intro}</p>
    <div class="lk-list">
      {local.items.map(i => (
        <article class="lk">
          <div class="lk-head">
            <h4>{i.place}</h4>
            <span class="lk-where">{i.where}</span>
          </div>
          <p class="lk-hook">{i.hook}</p>
          <p class="lk-body" set:html={i.body}></p>
          <p class="lk-do"><span>Do this</span>{i.doThis}</p>
        </article>
      ))}
    </div>
  </Fold>

  <Fold no={N_TIPS} sit="Audible" title="Fan Tips for London" id="intel" meta={`${tips.length} tips`}>
    <div class="intel-grid">
      {tips.map(t => (
        <div class="tip"><div class="icon">{t.icon}</div><h4>{t.title}</h4><p set:html={t.body}></p></div>
      ))}
    </div>
  </Fold>

  <Fold no={N_WORDS} sit="Signals" title="Speak the Language" id="glossary" meta={`${glossary.pairs.length} words`}>
    <p class="fold-intro">{glossary.intro}</p>
    <div class="gl-grid">
      {glossary.pairs.map(p => (
        <div class={`gl-pair${p.flag ? ' flagged' : ''}`}>
          <div class="gl-row"><span class="gl-us">{p.us}</span><span class="gl-arrow">→</span><span class="gl-uk">{p.uk}</span></div>
          {p.note && <p class="gl-note">{p.note}</p>}
        </div>
      ))}
    </div>
  </Fold>
</div></div>

</div>

<section class="red-canvas endzone" id="endzone">
  <div class="wrap">
    <span class="small-caps">Endzone</span>
    <h2 class="display">Ready to Run<br>the Playbook?</h2>
    <p>Tell us when you're in town and which game you're here for. We'll put the days around it together — tours, tables, transfers, the lot.</p>
    <div class="ctas">
      <a class="btn on-red" href={enquiry}>Plan My Trip ↗</a>
      <a class="btn on-red-outline" href="#lineup">Browse the Tours</a>
    </div>
  </div>
</section>
</Base>

<script>
  document.documentElement.classList.add('js-anim');
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
  }, { rootMargin: '0px 0px -60px 0px', threshold: 0.05 });
  const ANIM = '.tour, .tip, .around-card, .station, .gl-pair, .opt, .lk, .reveal';
  document.querySelectorAll(ANIM).forEach(el => io.observe(el));
  setTimeout(() => document.querySelectorAll(ANIM).forEach(el => el.classList.add('in')), 2000);

  // A fold opened after load has never been observed; reveal its contents at once.
  document.querySelectorAll('details.fold').forEach(d => d.addEventListener('toggle', () => {
    if (d.open) d.querySelectorAll(ANIM).forEach(el => el.classList.add('in'));
  }));
  // Deep link or in-page nav to a closed fold should open it.
  const openTarget = () => {
    const el = location.hash && document.querySelector(location.hash);
    const d = el?.closest?.('details.fold') || (el?.tagName === 'DETAILS' ? el : null);
    if (d) { d.open = true; d.querySelectorAll(ANIM).forEach(x => x.classList.add('in')); }
  };
  addEventListener('hashchange', openTarget); openTarget();

  const cd = document.getElementById('cd');
  if (cd) {
    const K = new Date(cd.dataset.kickoff).getTime();
    const pad = (v, w) => String(v).padStart(w, '0');
    const set = (k, v) => { const e = cd.querySelector(`[data-cd="${k}"]`); if (e) e.textContent = v; };
    (function tick() {
      let s = Math.max(0, Math.floor((K - Date.now()) / 1000));
      const d = Math.floor(s / 86400); s -= d * 86400;
      const h = Math.floor(s / 3600); s -= h * 3600;
      const m = Math.floor(s / 60); s -= m * 60;
      set('d', pad(d, 3)); set('h', pad(h, 2)); set('m', pad(m, 2)); set('s', pad(s, 2));
      setTimeout(tick, 1000);
    })();
  }
  document.querySelectorAll('.filter').forEach(f => f.addEventListener('click', () => {
    document.querySelectorAll('.filter').forEach(x => x.classList.remove('active'));
    f.classList.add('active');
    const c = f.dataset.cat;
    document.querySelectorAll('.tour').forEach(t => { t.style.display = (c === 'all' || t.dataset.cat === c) ? '' : 'none'; });
  }));
  document.querySelectorAll('[data-count]').forEach(el => {
    const target = +el.dataset.count, w = +el.dataset.pad || 0, comma = el.dataset.comma;
    let i = 0; const step = Math.max(1, Math.round(target / 40));
    const t = setInterval(() => {
      i = Math.min(target, i + step);
      el.textContent = comma ? i.toLocaleString() : String(i).padStart(w, '0');
      if (i >= target) clearInterval(t);
    }, 25);
  });
</script>
